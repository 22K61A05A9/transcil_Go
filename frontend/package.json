{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript/lib/tsc.js -b && vite build",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js -b --pretty false",
    "verify:auth": "tsx --tsconfig tsconfig.verify.json scripts/verify-auth-foundation.ts",
    "verify:auth-provider": "tsx --tsconfig tsconfig.verify.json scripts/verify-auth-provider.ts",
    "verify:routes": "tsx --tsconfig tsconfig.verify.json scripts/verify-routes.ts",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.5.2",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^6.4.1",
    "vitest": "^4.1.10"
  }
}
