# Safe template — copy and fill in locally (do not commit filled copies).
#   copy .env.example .env
#   copy .env.example services\user\.env
#   (repeat for admin, merchant, transaction, report, gateway as needed)
#   copy .env.docker .env.docker   # optional Docker reference file

DB_USER=gouser
DB_PASSWORD=Go123
DB_HOST=localhost
# Docker Compose maps MySQL to host port 3307 (container 3306)
DB_PORT=3307
DB_NAME=paylater

JWT_SECRET=paylater-secret-key

# Shared secret for service-to-service calls (X-Internal-Token)
INTERNAL_SERVICE_TOKEN=paylater-internal-token

# Local (non-Docker) upstream URLs — run each service on host
USER_SERVICE_URL=http://localhost:9091
TRANSACTION_SERVICE_URL=http://localhost:9092
ADMIN_SERVICE_URL=http://localhost:9093
MERCHANT_SERVICE_URL=http://localhost:9094
REPORT_SERVICE_URL=http://localhost:9095

# Docker Compose (set in services/*/.env when using docker compose):
#   DB_HOST=mysql
#   DB_PORT=3306
#   USER_SERVICE_URL=http://user:9091
#   TRANSACTION_SERVICE_URL=http://transaction:9092
#   ADMIN_SERVICE_URL=http://admin:9093
#   MERCHANT_SERVICE_URL=http://merchant:9094
#   REPORT_SERVICE_URL=http://report:9095
